# Built public website (scripts/tools/build_site.py)
site/dist/

# Remaster: editable .blend sources are regenerated by art/remaster/build_*.py (kept locally, ~280 MB)
art/remaster/blend/

# Audio pipeline: CC0 instrument recordings fetched by art/audio/fetch_samples.py (~1.5 GB)
art/audio/samples/
art/audio/.cache/

# Royal UI: raw Codex generations (~200 MB) live locally; installed, trimmed copies are in assets/.
# Re-run art/royal/codexgen.py to regenerate, then the install scripts in art/royal/.
art/royal/gen/
