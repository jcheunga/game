<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="server/**" />
    <!-- Native plugin builds clone the Godot source, C# test files included, into native/*/build. -->
    <Compile Remove="native/**" />
    <Compile Remove="scripts/tests/**" Condition="'$(Configuration)' == 'ExportRelease' Or '$(Configuration)' == 'Release'" />
  </ItemGroup>
</Project>
