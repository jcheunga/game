; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crownroad"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://assets/branding/crownroad-app-icon-1024.png"

[autoload]

SaveSystem="*res://scenes/autoload/SaveSystem.tscn"
GameState="*res://scenes/autoload/GameState.tscn"
SceneRouter="*res://scenes/autoload/SceneRouter.tscn"
AudioDirector="*res://scenes/autoload/AudioDirector.tscn"
AppLifecycleService="*res://scenes/autoload/AppLifecycleService.tscn"
LanChallengeService="*res://scenes/autoload/LanChallengeService.tscn"
ChallengeSyncService="*res://scenes/autoload/ChallengeSyncService.tscn"
ChallengeLeaderboardService="*res://scenes/autoload/ChallengeLeaderboardService.tscn"
ChallengeBoardFeedService="*res://scenes/autoload/ChallengeBoardFeedService.tscn"
ChallengeBoardFeedSmokeDirector="*res://scenes/autoload/ChallengeBoardFeedSmokeDirector.tscn"
ChallengeLeaderboardSmokeDirector="*res://scenes/autoload/ChallengeLeaderboardSmokeDirector.tscn"
ChallengeSyncSmokeDirector="*res://scenes/autoload/ChallengeSyncSmokeDirector.tscn"
LanSmokeDirector="*res://scenes/autoload/LanSmokeDirector.tscn"
NativeIAPService="*res://scenes/autoload/NativeIAPService.tscn"
SafeAreaService="*res://scenes/autoload/SafeAreaService.tscn"
MusicPlayer="*res://scenes/autoload/MusicPlayer.tscn"
DebugConsole="*res://scenes/autoload/DebugConsole.tscn"
CrashReporter="*res://scenes/autoload/CrashReporter.tscn"
NetworkStatus="*res://scenes/autoload/NetworkStatus.tscn"
DeepLinkHandler="*res://scenes/autoload/DeepLinkHandler.tscn"

[crownroad]

# Leave blank for local development. Set the final HTTPS API origin here before
# a store export, for example: https://api.your-domain.example
network/api_base_url=""

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
