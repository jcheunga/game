# Crownroad Server Configuration
# Copy this to .env and fill in your values

# Stripe payment processing (desktop/web only; never use this for in-app mobile currency)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Play consumable verification. The service account needs Android
# Publisher access for this app. Prefer the *_PATH form in production so the
# JSON key never enters a process environment or source-control file.
GOOGLE_PLAY_PACKAGE_NAME=com.crownroad.game
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google-play-service-account.json
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# App Store Server API verification. Create an In-App Purchase key in App Store
# Connect, then mount its .p8 file as a secret. The iOS client bridge must send
# the deterministic app-account token documented in PRODUCTION_LAUNCH.md.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_BUNDLE_ID=com.crownroad.game
APPLE_IAP_PRIVATE_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
# APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# CORS allowed origins (comma-separated). Do not use * in production.
AllowedOrigins=https://crownroad.game,https://app.crownroad.game

# Local Debug tests use an isolated SQLite driver. Release builds and every
# Docker deployment require PostgreSQL. Keep the password in a mounted secret
# rather than this file.
# DatabaseConnectionString=Host=postgres.example;Port=5432;Database=crownroad;Username=crownroad;Ssl Mode=Require
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password

# Test-only switch. Never define this in a deployed environment: it bypasses
# store verification so the isolated server test suite can use synthetic tokens.
# CROWNROAD_ALLOW_TEST_PURCHASE_CLAIMS=1
