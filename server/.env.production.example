# Public API host. Point an A/AAAA DNS record here before deployment.
CROWNROAD_API_DOMAIN=api.crownroad.game
CADDY_EMAIL=ops@crownroad.game

# Public website host. Point A/AAAA records for this name and its www. alias at
# the same server. It must match "domain" in site/site.json (see docs/WEBSITE.md).
CROWNROAD_SITE_DOMAIN=crownroad.game

# Only browser origins belong here; never use * in production.
AllowedOrigins=https://crownroad.game,https://app.crownroad.game

# Managed PostgreSQL connection. Paste the provider's pooled PostgreSQL URL
# here. It must use verified TLS (for example: sslmode=verify-full). This file
# is a deployment secret and must never be committed after it is populated.
DATABASE_URL=postgresql://game_user:replace-with-password@db.example.com:6432/crownroad?sslmode=verify-full&sslrootcert=system&pooling=true&min_pool_size=5&max_pool_size=40&application_name=crownroad-api

# Redis holds shared rate-limit counters so horizontal API replicas apply one
# consistent policy. Keep it private to the Compose network.
REDIS_PASSWORD_SOURCE=./secrets/redis-password
CROWNROAD_SERVER_REPLICAS=2

# File paths on the deployment host. Keep this directory owner-readable only
# and outside source control. Each file is mounted as a Docker Compose secret.
ADMIN_API_KEY_SOURCE=./secrets/admin-api-key
GOOGLE_PLAY_SERVICE_ACCOUNT_SOURCE=./secrets/google-play-service-account.json
# For an Android-only launch, delete this line or leave it blank: App Store
# purchases are then refused as "not configured". Never use a placeholder key.
APPLE_IAP_PRIVATE_KEY_SOURCE=./secrets/AuthKey_XXXXXXXXXX.p8

# Store API configuration. The secret payloads above are mounted separately.
GOOGLE_PLAY_PACKAGE_NAME=com.crownroad.game
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_BUNDLE_ID=com.crownroad.game

# Desktop/web checkout only. Leave both blank until Stripe is intentionally
# enabled and its signed webhook is configured for this API domain.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Never add CROWNROAD_ALLOW_TEST_PURCHASE_CLAIMS here.

# Account sign-in. Google uses a Web application OAuth client with this exact callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

# Sign in with Apple (required on iOS wherever Google sign-in is shown). The
# Services ID, its Sign in with Apple key and the exact registered return URL.
# The .p8 key is separate from the In-App Purchase key; give it as a mounted
# file or inline on one line with \n for each newline.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_REDIRECT_URI=https://api.example.com/auth/apple/callback
# APPLE_SIGN_IN_PRIVATE_KEY_PATH=/run/secrets/AuthKey_SIGNIN.p8
# APPLE_SIGN_IN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Encrypts the Apple refresh tokens that account deletion revokes; required for
# Sign in with Apple. 32 random bytes in base64 (openssl rand -base64 32), set
# here or as a file through ACCOUNT_TOKEN_KEY_PATH. Never change it once set.
ACCOUNT_TOKEN_KEY=

# Phone game accounts. Play Games uses its Game server OAuth client; Game Center
# checks signatures against the app's bundle ID (defaults to APPLE_IAP_BUNDLE_ID).
PLAY_GAMES_CLIENT_ID=
PLAY_GAMES_CLIENT_SECRET=
# GAME_CENTER_BUNDLE_ID=com.crownroad.game

# Email one-time codes over TLS. No passwords are stored by the game.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
