# Settings for server/ops/watch.sh. Copy to /etc/crownroad-watch.env (owner
# the deploy user, mode 600: the webhook URL is a secret) and pass
# --config /etc/crownroad-watch.env. Every line is optional except the webhook.
# A variable set in the environment overrides this file.

# Where alerts go. Slack incoming webhook, Discord webhook, an ntfy topic URL
# or any receiver that takes a JSON POST. ALERT_FORMAT=auto picks the shape
# from the URL; set slack, discord, ntfy or generic to force one.
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX
#ALERT_FORMAT=auto
# Bearer token for a protected receiver (an ntfy access token, for example).
#ALERT_WEBHOOK_TOKEN=
# How often an unresolved problem is repeated (minutes).
#REALERT_MINUTES=240

# Public API origin. Default: https://$CROWNROAD_API_DOMAIN from server/.env.production.
#API_URL=https://api.crownroad.game
#HOST_LABEL=crownroad-vm-1
#STATE_DIR=/var/lib/crownroad-watch

# Which checks to run (comma-separated).
#CHECKS=health,tls,containers,disk,caddy,backup,postgres

# /health must answer "healthy" within this many seconds, and is slow above the ms limit.
#HEALTH_TIMEOUT=5
#HEALTH_SLOW_MS=2000

# Certificate days left. Caddy renews about 30 days ahead.
#TLS_WARN_DAYS=21
#TLS_CRIT_DAYS=7

# Compose project (the directory name of server/, lower-cased) and services.
#COMPOSE_PROJECT=server
#EXPECTED_SERVICES=redis crownroad-server caddy
#API_SERVICE=crownroad-server
#API_REPLICAS=2

# Disks to watch; Docker's data directory is added automatically.
#DISK_PATHS=/
#DISK_WARN_PERCENT=80
#DISK_CRIT_PERCENT=90

# Caddy access log window and limits. CADDY_LOG_FILE reads a file instead of
# `docker logs` (for a Caddy outside Docker).
#CADDY_WINDOW_MINUTES=5
#FIVEXX_WARN_PERCENT=1
#FIVEXX_CRIT_PERCENT=5
#FIVEXX_MIN_REQUESTS=20
#LATENCY_P95_WARN_MS=1000
#PURCHASE_REFUSED_WARN=10
#CADDY_LOG_FILE=

# Backups: a directory of dump files, or a command that prints the newest
# backup's time (epoch seconds or ISO 8601), e.g. from the provider's CLI.
#BACKUP_DIR=/srv/backups/crownroad
#BACKUP_GLOB=*.dump*
#BACKUP_CHECK_CMD=
#BACKUP_MAX_AGE_HOURS=26

# PostgreSQL connections and size, read-only. Use a monitoring role with no
# password in the URL and put the password in ~/.pgpass.
#PG_MONITOR_URL=postgresql://crownroad_monitor@db.example.com:5432/crownroad?sslmode=verify-full&sslrootcert=system
#PG_CONN_WARN_PERCENT=80
#PG_MAX_DB_GB=

# Dead man's switch (e.g. a healthchecks.io ping URL), pinged after every run.
#HEARTBEAT_URL=
